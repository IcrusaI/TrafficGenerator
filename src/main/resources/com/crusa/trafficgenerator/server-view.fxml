<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<AnchorPane minHeight="100.0" minWidth="150.0" xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.crusa.trafficgenerator.view.ServerViewController">
   <ToolBar prefHeight="25.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
      <Button mnemonicParsing="false" onAction="#backToHome" text="Назад" />
      <Pane HBox.hgrow="ALWAYS" />
      <AnchorPane prefHeight="25.0" prefWidth="64.0">
         <Button fx:id="stopButton" defaultButton="true" mnemonicParsing="false" onAction="#stopReceiver" text="Остановить" />
         <Button fx:id="startButton" defaultButton="true" mnemonicParsing="false" onAction="#startReceiver" prefHeight="25.0" prefWidth="80.0" text="Запустить" />
      </AnchorPane>
   </ToolBar>
   <VBox AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="40.0">
      <AnchorPane nodeOrientation="LEFT_TO_RIGHT" prefHeight="32.0" prefWidth="270.0">
         <Label contentDisplay="RIGHT" text="Порт">
            <graphic>
               <TextField fx:id="portText" prefHeight="25.0" prefWidth="130.0" promptText="5555" />
            </graphic>
         </Label>
      </AnchorPane>
      <AnchorPane nodeOrientation="LEFT_TO_RIGHT" prefHeight="32.0" prefWidth="270.0">
         <Label contentDisplay="RIGHT" text="Тип">
            <graphic>
               <ComboBox fx:id="protocolCombobox" prefWidth="150.0" promptText="Выберите тип..." />
            </graphic>
         </Label>
      </AnchorPane>
   </VBox>
   <VBox prefHeight="200.0" prefWidth="100.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="200.0">
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Результат:" textAlignment="CENTER">
         <VBox.margin>
            <Insets />
         </VBox.margin>
         <font>
            <Font size="15.0" />
         </font>
      </Text>
      <AnchorPane prefHeight="32.0" prefWidth="270.0">
         <Label contentDisplay="RIGHT" text="Получено">
            <graphic>
               <TextField fx:id="receivedPackagesText" editable="false" prefHeight="25.0" prefWidth="71.0" />
            </graphic>
         </Label>
         <Text layoutX="153.0" layoutY="18.0" text="пакетов" wrappingWidth="74.94921875" />
      </AnchorPane>
   </VBox>
</AnchorPane>